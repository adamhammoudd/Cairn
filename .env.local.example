NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Self-hosted AI model. Cairn calls no third-party model API - you run the
# model yourself. Any OpenAI-compatible server works: Ollama, vLLM,
# llama.cpp's server, LM Studio. See docs/self-hosted-model.md for setup.
#
# Ollama's OpenAI-compatible path is /v1 (note: not the native /api path).
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
# Only needed if you've put auth in front of your inference server (recommended
# if it's reachable from outside the VPS - see the docs).
LLM_API_KEY=
# CPU-only boxes are slow; raise this if you see timeouts.
LLM_TIMEOUT_MS=180000

# Optional live-quote provider. Unset = fall back to last close from the
# historical trend store (clearly labeled as delayed in the UI).
TWELVE_DATA_API_KEY=
