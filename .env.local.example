NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI model provider: Groq, over its OpenAI-compatible API, running
# openai/gpt-oss-120b. The free tier caps the WHOLE app at 200,000 tokens a
# day; the paid Developer tier removes that cap - set a spending limit in the
# Groq console (Settings > Billing).
#
# Any other OpenAI-compatible host works by changing these values, but it must
# be named on the privacy page (src/app/privacy/page.tsx) first - it receives
# chat text.
#
# These values must be set in BOTH .env.local (local dev) and Vercel's
# environment variables (deploys). A localhost URL here is always wrong for a
# deployed build - Vercel has no route back to your machine.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Required: your Groq API key. Server-side only - never prefix with
# NEXT_PUBLIC_, never commit a real value. Set it in Vercel > Project >
# Settings > Environment Variables for Production and Preview too.
# (The old name GROQ_API_KEY is no longer read - use LLM_API_KEY.)
LLM_API_KEY=
# A ceiling, not a target.
LLM_TIMEOUT_MS=60000

# Optional second endpoint, tried automatically only when the primary is
# rate-limited or down after its retries. A real configuration fault on the
# primary (bad key, bad model id) is never masked by it. Leave empty unless
# you want one - a fallback is a second AI provider and must also be named on
# the privacy page. FALLBACK_LLM_MODEL defaults to LLM_MODEL.
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=

# Optional live-quote provider (Tiingo). Unset = fall back to last close from the
# historical trend store (clearly labeled as delayed in the UI); intraday charts
# stay on Yahoo.
#
# LEGAL: do NOT set this in production yet. Tiingo licenses its API data for
# internal use only on every self-serve plan (Starter, Power, Commercial):
# displaying it to Cairn subscribers needs a redistribution licence from
# Tiingo (sales@tiingo.com). Also: Starter allows 50 requests/hour, which one
# actively-viewed symbol can exceed. See the LEGAL note in
# src/lib/market-data/provider.ts.
TIINGO_API_KEY=

# Shared secret the scheduled Edge Functions require from pg_cron. They are
# deployed --no-verify-jwt so the scheduler can reach them, which means this is
# the only thing standing between an ingestion run and anyone with curl.
# Generate with: openssl rand -hex 32
# Must match: alter database postgres set app.settings.cron_secret = '<value>';
CRON_SECRET=

# Premium upgrades. Set to "true" only once STRIPE_* below are all set and the
# webhook endpoint is live and verified. billingEnabled() requires BOTH this
# flag AND a configured Stripe key, so a half-configured deploy shows the
# pre-launch stub rather than a checkout button that 500s. Without the gate, a
# form POST to setTier() is a free premium subscription for anyone with an
# account. Downgrades to free are always allowed regardless of this flag.
BILLING_ENABLED=

# ---------------------------------------------------------------------------
# Stripe billing (Phase 12). Server-side only - never NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# Test mode first (sk_test_... / a test-mode price / `stripe listen` secret),
# then swap all three for live values once a real end-to-end test has passed.
#   STRIPE_SECRET_KEY     - Developers > API keys
#   STRIPE_PRICE_PREMIUM  - the recurring Price id for the Premium product
#   STRIPE_WEBHOOK_SECRET - `stripe listen --forward-to localhost:3000/api/stripe/webhook`
#                           prints whsec_... in dev; in prod it's shown when you
#                           create the endpoint at Developers > Webhooks
# The webhook endpoint must subscribe to: checkout.session.completed,
# customer.subscription.created / .updated / .deleted, invoice.paid,
# invoice.payment_failed.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PREMIUM=
STRIPE_WEBHOOK_SECRET=

# Optional pepper for the auth rate-limit ledger's identifier hashes
# (src/lib/auth-rate-limit.ts). Falls back to the service-role key if unset.
AUTH_HASH_SALT=

# Scope guard layer 3 (model-based classifier) posture when the inference
# server is unreachable: "advisory" ships on layers 1-2 and logs, "strict"
# blocks the response, "off" disables layer 3. See
# docs/decisions/2026-08-20-scope-classifier-failure-posture.md
SCOPE_CLASSIFIER_MODE=advisory

# Assistant portfolio figures - docs/decisions/2026-09-04-ai-portfolio-figures.md,
# option (c). OFF by default and in EVERY deployed environment. Only the exact
# string "true" enables it. When on, the chat assistant's context gains a
# PORTFOLIO_SUMMARY block: the reader's own code-computed total value and
# today's change, plus per-holding cost basis / unrealized P&L for a ticker
# they name and hold. The model may only restate those figures verbatim -
# checkPortfolioFigureDrift() fails the turn closed on any dollar or personal
# percentage figure that isn't one of them. With this unset, behaviour is
# exactly PR #58 (ticker symbols only, no figures).
#
# LEGAL / VENDOR: do NOT set this in a deployed environment until the founder
# has confirmed Groq's data-retention / DPA terms cover transmitting real
# dollar figures to inference. That is a vendor-account check, not an
# engineering decision.
ENABLE_PORTFOLIO_CONTEXT=

# ---------------------------------------------------------------------------
# Account security and beta access
# ---------------------------------------------------------------------------
# hCaptcha site key (public - it is sent to every browser). CAPTCHA protection
# is switched on in Supabase (Authentication > Attack protection) with the
# hCaptcha SECRET stored there; Supabase checks the token itself, so the secret
# never goes in this file or in Vercel. With captcha on in Supabase and this
# empty, sign-in, sign-up and password reset all fail. hCaptcha does not
# serve real keys on "localhost" - open the local app at http://127.0.0.1:3000,
# or add a test domain in the hCaptcha dashboard.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# MANUAL OVERRIDE beta invite codes, comma-separated, each at least 8
# characters. Shared links /signup?invite=<code> for hand-picked people outside
# the waitlist order. Personal invites (below) are the normal path. Revoke a
# code by removing it and redeploying.
BETA_INVITE_CODES=

# Personal beta invites (src/lib/beta-invites, migration 0064). The
# send-beta-invites Vercel cron (vercel.json) emails confirmed waitlist members
# in order. It also needs CRON_SECRET above set on Vercel (Vercel sends it as
# a Bearer token) and NEXT_PUBLIC_SITE_URL for the link.
#   BETA_INVITES_ENABLED        - kill switch; "1" = on, anything else = off
#   BETA_MAX_ACTIVE_USERS       - cap on active beta users + open invites (default 50)
#   BETA_INVITES_PER_RUN        - new invites per run (default 5)
#   BETA_INVITES_ALLOW_NON_PROD - "1" lets a non-production deploy send; leave unset
BETA_INVITES_ENABLED=
BETA_MAX_ACTIVE_USERS=50
BETA_INVITES_PER_RUN=5
BETA_INVITES_ALLOW_NON_PROD=

# ---------------------------------------------------------------------------
# Pre-launch waitlist (/waitlist)
# ---------------------------------------------------------------------------
# The waitlist confirmation email goes out via Resend's HTTP API (the launch
# setup) or, as a TEMPORARY bridge, via Gmail SMTP. Provider precedence in
# src/lib/waitlist.ts: Resend if both RESEND_* vars are set, else Gmail if both
# GMAIL_SMTP_* vars are set, else the confirmation link is only logged to the
# server console (no one can confirm, founding-50 list can't be finalised).
#   RESEND_API_KEY      - from https://resend.com/api-keys
#   WAITLIST_EMAIL_FROM - a verified sender, e.g. "Cairn <hello@mail.yourdomain>"
RESEND_API_KEY=
WAITLIST_EMAIL_FROM=

# --- TEMPORARY Gmail SMTP bridge -------------------------------------------
# Only used while no Resend domain is verified. Setting the RESEND_* pair above
# automatically retires this path. Gmail caps a normal account at ~500 msgs/day
# and provides no domain-level auth (SPF/DKIM) for Cairn, so this is a
# stopgap for pre-launch volume only - not the real setup. See the banner in
# src/lib/waitlist.ts (sendViaGmailSmtp) and migration 0036.
#   GMAIL_SMTP_USER         - the Gmail address to send from
#   GMAIL_SMTP_APP_PASSWORD - a 16-char Google App Password, NOT the account
#                             password (Google Account > Security > 2-Step
#                             Verification > App passwords)
#   GMAIL_SMTP_DAILY_CAP    - optional; max sends/day before the bridge stops
#                             attempting. Default 400 (headroom under Gmail's
#                             ~500 limit).
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
GMAIL_SMTP_DAILY_CAP=

# Absolute base URL used to build the confirmation link in that email. Falls
# back to the request Origin header, then http://localhost:3000. Set this in
# Vercel so the link points at the real domain regardless of which host the
# server action ran behind.
NEXT_PUBLIC_SITE_URL=

SEC_CONTACT_EMAIL=