NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI model provider: Groq, over its OpenAI-compatible API.
#
# These values must be set in BOTH .env.local (local dev) and Vercel's
# environment variables (deploys). A localhost URL here is always wrong for a
# deployed build - Vercel has no route back to your machine.
LLM_BASE_URL=https://api.groq.com/openai/v1
# Checked against Groq's model list, not assumed: llama-3.3-70b-versatile was
# deprecated 2026-08-16 and openai/gpt-oss-120b is its named replacement.
# Re-check https://console.groq.com/docs/deprecations before changing this.
LLM_MODEL=openai/gpt-oss-120b

# Required. Server-side only - never prefix with NEXT_PUBLIC_, never commit a
# real value. Set the same key in Vercel > Project > Settings > Environment
# Variables for Production, Preview and Development.
GROQ_API_KEY=

# Optional alias, read only if GROQ_API_KEY is unset. Lets a different
# OpenAI-compatible host be swapped in without a code change.
LLM_API_KEY=
# Groq is fast; this is a ceiling, not a target.
LLM_TIMEOUT_MS=60000

# Optional live-quote provider. Unset = fall back to last close from the
# historical trend store (clearly labeled as delayed in the UI).
TWELVE_DATA_API_KEY=

# Shared secret the scheduled Edge Functions require from pg_cron. They are
# deployed --no-verify-jwt so the scheduler can reach them, which means this is
# the only thing standing between an ingestion run and anyone with curl.
# Generate with: openssl rand -hex 32
# Must match: alter database postgres set app.settings.cron_secret = '<value>';
CRON_SECRET=

# Premium upgrades. There is no payment processor wired up yet, so this is
# unset (= disabled) and setTier() refuses upgrades server-side. Without the
# gate, a form POST to that action is a free premium subscription for anyone
# with an account. Set to "true" only once Stripe (or equivalent) is live and
# a verified webhook is what actually grants the tier.
# Downgrades to free are always allowed regardless of this flag.
BILLING_ENABLED=

# Optional pepper for the auth rate-limit ledger's identifier hashes
# (src/lib/auth-rate-limit.ts). Falls back to the service-role key if unset.
AUTH_HASH_SALT=

# Scope guard layer 3 (model-based classifier) posture when the inference
# server is unreachable: "advisory" ships on layers 1-2 and logs, "strict"
# blocks the response, "off" disables layer 3. See
# docs/decisions/2026-08-20-scope-classifier-failure-posture.md
SCOPE_CLASSIFIER_MODE=advisory
