NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI model provider: Groq, over its OpenAI-compatible API.
#
# These values must be set in BOTH .env.local (local dev) and Vercel's
# environment variables (deploys). A localhost URL here is always wrong for a
# deployed build - Vercel has no route back to your machine.
LLM_BASE_URL=https://api.groq.com/openai/v1
# Checked against Groq's model list, not assumed: llama-3.3-70b-versatile was
# deprecated 2026-08-16 and openai/gpt-oss-120b is its named replacement.
# Re-check https://console.groq.com/docs/deprecations before changing this.
LLM_MODEL=openai/gpt-oss-120b

# Required. Server-side only - never prefix with NEXT_PUBLIC_, never commit a
# real value. Set the same key in Vercel > Project > Settings > Environment
# Variables for Production, Preview and Development.
GROQ_API_KEY=

# Optional alias, read only if GROQ_API_KEY is unset. Lets a different
# OpenAI-compatible host be swapped in without a code change.
LLM_API_KEY=
# Groq is fast; this is a ceiling, not a target.
LLM_TIMEOUT_MS=60000

# Optional second endpoint, tried automatically only once the primary is
# exhausted (a 429 whose message says "tokens per day"/"TPD" - Groq's free
# tier caps the whole app, not per user, at 200,000 tokens/day). A real
# configuration fault on the primary (bad key, bad model id) is never masked
# by this - only a reachable-but-refusing primary falls through.
#
# Verified from provider docs, not yet tested live (needs an account this repo
# does not have): Cerebras' free trial serves the same GPT-OSS 120B weights at
# roughly 5x Groq's free daily budget, so output quality is unaffected either
# way - only which datacenter answered. Sign up at https://cloud.cerebras.ai,
# then:
#   FALLBACK_LLM_BASE_URL=https://api.cerebras.ai/v1
#   FALLBACK_LLM_API_KEY=<your Cerebras key>
# FALLBACK_LLM_MODEL defaults to "gpt-oss-120b" (Cerebras' id - no "openai/"
# prefix, unlike Groq's LLM_MODEL). Only set this to override for a different
# host.
#
# LEGAL: a configured fallback is a second AI subprocessor. Update
# docs/legal/privacy-policy.md and jurisdictional-checklist.md to name it,
# the same treatment Groq got - see docs/decisions/2026-08-30-groq-fallback-endpoint.md.
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=

# Optional live-quote provider. Unset = fall back to last close from the
# historical trend store (clearly labeled as delayed in the UI).
TWELVE_DATA_API_KEY=

# Shared secret the scheduled Edge Functions require from pg_cron. They are
# deployed --no-verify-jwt so the scheduler can reach them, which means this is
# the only thing standing between an ingestion run and anyone with curl.
# Generate with: openssl rand -hex 32
# Must match: alter database postgres set app.settings.cron_secret = '<value>';
CRON_SECRET=

# Premium upgrades. Set to "true" only once STRIPE_* below are all set and the
# webhook endpoint is live and verified. billingEnabled() requires BOTH this
# flag AND a configured Stripe key, so a half-configured deploy shows the
# pre-launch stub rather than a checkout button that 500s. Without the gate, a
# form POST to setTier() is a free premium subscription for anyone with an
# account. Downgrades to free are always allowed regardless of this flag.
BILLING_ENABLED=

# ---------------------------------------------------------------------------
# Stripe billing (Phase 12). Server-side only - never NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# Test mode first (sk_test_... / a test-mode price / `stripe listen` secret),
# then swap all three for live values once a real end-to-end test has passed.
#   STRIPE_SECRET_KEY     - Developers > API keys
#   STRIPE_PRICE_PREMIUM  - the recurring Price id for the Premium product
#   STRIPE_WEBHOOK_SECRET - `stripe listen --forward-to localhost:3000/api/stripe/webhook`
#                           prints whsec_... in dev; in prod it's shown when you
#                           create the endpoint at Developers > Webhooks
# The webhook endpoint must subscribe to: checkout.session.completed,
# customer.subscription.created / .updated / .deleted, invoice.paid,
# invoice.payment_failed.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PREMIUM=
STRIPE_WEBHOOK_SECRET=

# Optional pepper for the auth rate-limit ledger's identifier hashes
# (src/lib/auth-rate-limit.ts). Falls back to the service-role key if unset.
AUTH_HASH_SALT=

# Scope guard layer 3 (model-based classifier) posture when the inference
# server is unreachable: "advisory" ships on layers 1-2 and logs, "strict"
# blocks the response, "off" disables layer 3. See
# docs/decisions/2026-08-20-scope-classifier-failure-posture.md
SCOPE_CLASSIFIER_MODE=advisory

# ---------------------------------------------------------------------------
# Pre-launch waitlist (/waitlist)
# ---------------------------------------------------------------------------
# The waitlist confirmation email is sent via Resend's HTTP API. REQUIRED
# before the waitlist page goes live: without both of these the signup still
# writes a row, but the confirmation link is only logged to the server console,
# so no one can confirm and the founding-50 list can never be finalised.
#   RESEND_API_KEY   - from https://resend.com/api-keys
#   WAITLIST_EMAIL_FROM - a verified sender, e.g. "Cairn <hello@mail.yourdomain>"
RESEND_API_KEY=
WAITLIST_EMAIL_FROM=

# Absolute base URL used to build the confirmation link in that email. Falls
# back to the request Origin header, then http://localhost:3000. Set this in
# Vercel so the link points at the real domain regardless of which host the
# server action ran behind.
NEXT_PUBLIC_SITE_URL=
